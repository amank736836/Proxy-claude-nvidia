NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k2.6

# ─── Rate limiting (NVIDIA free tier = 40 requests/min per model) ─────────────
# Max outgoing requests per rolling 60s window. Lower this if you're getting
# 429s; raise it only if you've upgraded your NVIDIA quota.
NVIDIA_RPM_LIMIT=40

# How long a single Claude Code request will queue (sleep) waiting for a slot
# before the proxy returns HTTP 429 to the client. Keeps Claude Code from
# hanging indefinitely during a burst.
NVIDIA_RPM_MAX_WAIT_MS=8000

# If NVIDIA still returns 429 despite the local cap (e.g. shared tenant spike),
# pause the local limiter for this many ms and reject incoming requests with
# 429 + Retry-After instead of queueing against a known-bad endpoint.
NVIDIA_RPM_429_BACKOFF_MS=15000

# ─── Network binding ──────────────────────────────────────────────────────────
# The proxy listens on loopback (127.0.0.1) only by default. Only set this to
# 0.0.0.0 if you intentionally want other machines on your LAN to reach it;
# the proxy has no client authentication.
# HOST=127.0.0.1
